<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Dark theme: deep navy with a teal-to-violet glow and gold accents. -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0D1C25" Offset="0" />
        <GradientStop Color="#121A2B" Offset="0.5" />
        <GradientStop Color="#1C1734" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeaderBrush" Color="#111722" />
    <SolidColorBrush x:Key="HeaderLineBrush" Color="#F2B233" />
    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#E6232A3B" Offset="0" />
        <GradientStop Color="#E61B2030" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#262D40" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2E3649" />
    <SolidColorBrush x:Key="InkBrush" Color="#F2F4F8" />
    <SolidColorBrush x:Key="BodyBrush" Color="#C3CAD6" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8A94A6" />
    <SolidColorBrush x:Key="LineBrush" Color="#2A3142" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F5B32F" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFC650" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#18202D" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#33F5B32F" />
    <SolidColorBrush x:Key="InputBrush" Color="#141A26" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#323B4E" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#1A2030" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#252C3E" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#343D51" />
    <SolidColorBrush x:Key="ThumbBackgroundBrush" Color="#141A26" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#3A4357" />
    <SolidColorBrush x:Key="MenuBrush" Color="#1B2131" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#2A3246" />
    <SolidColorBrush x:Key="RecordingBarBrush" Color="#111722" />
    <SolidColorBrush x:Key="RecordingBarBorderBrush" Color="#F2B233" />
</ResourceDictionary>
