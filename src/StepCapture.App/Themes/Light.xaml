<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light theme: same layout and gold accent on soft gray. -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F4F6F9" Offset="0" />
        <GradientStop Color="#EEF1F6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeaderBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderLineBrush" Color="#F2B233" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#FAFBFC" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E1E5EC" />
    <SolidColorBrush x:Key="InkBrush" Color="#1A2130" />
    <SolidColorBrush x:Key="BodyBrush" Color="#3A4253" />
    <SolidColorBrush x:Key="MutedBrush" Color="#646D7E" />
    <SolidColorBrush x:Key="LineBrush" Color="#E3E6EC" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F2AC22" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#DD9813" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#18202D" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#26F2AC22" />
    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#D5DAE3" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#EEF0F4" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#DCE0E8" />
    <SolidColorBrush x:Key="ThumbBackgroundBrush" Color="#F1F3F6" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C5CBD6" />
    <SolidColorBrush x:Key="MenuBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuHoverBrush" Color="#F1F3F7" />
    <SolidColorBrush x:Key="RecordingBarBrush" Color="#1A2130" />
    <SolidColorBrush x:Key="RecordingBarBorderBrush" Color="#F2B233" />
</ResourceDictionary>
