<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>StepCapture</AssemblyName>
    <RootNamespace>StepCapture.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\StepCapture.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\StepCapture.Core\StepCapture.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\StepCapture.ico" />
    <Using Include="System.IO" />
  </ItemGroup>
</Project>
