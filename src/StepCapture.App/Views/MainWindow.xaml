<Window x:Class="StepCapture.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StepCapture" Width="1280" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="{StaticResource PanelBrush}" Foreground="{StaticResource InkBrush}"
        Icon="/Assets/StepCapture.ico" AllowDrop="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <DockPanel>
        <!-- Toolbar -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,10">
            <DockPanel LastChildFill="False">
                <Button x:Name="RecordButton" Style="{StaticResource AccentButton}" Click="OnRecord"
                        ToolTip="Start capturing clicks and keystrokes">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Record" />
                    </StackPanel>
                </Button>
                <Button Content="New" Style="{StaticResource ToolButton}" Click="OnNew" ToolTip="Start an empty guide (Ctrl+N)" />
                <Button Content="Open…" Style="{StaticResource ToolButton}" Click="OnOpen" ToolTip="Open a .stepguide file (Ctrl+O)" />
                <Button Content="Save" Style="{StaticResource ToolButton}" Click="OnSave" ToolTip="Save (Ctrl+S)" />
                <Button Content="Save as…" Style="{StaticResource ToolButton}" Click="OnSaveAs" />
                <Button x:Name="ExportButton" Style="{StaticResource ToolButton}" Click="OnExportMenu" ToolTip="Export to HTML, Word, PDF or Markdown">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Export" />
                        <TextBlock Text=" ▾" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ExportMenu" />
                    </Button.ContextMenu>
                </Button>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" />
            </DockPanel>
        </Border>

        <!-- Title and description -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10,16,12">
            <StackPanel>
                <TextBox x:Name="TitleBox" FontSize="20" FontWeight="SemiBold" BorderThickness="0" Padding="0"
                         TextChanged="OnGuideTextChanged" ToolTip="Guide title" />
                <TextBox x:Name="DescriptionBox" Foreground="{StaticResource MutedBrush}" BorderThickness="0" Padding="0" Margin="0,4,0,0"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="60" VerticalScrollBarVisibility="Auto"
                         TextChanged="OnGuideTextChanged" ToolTip="Optional description shown at the top of the guide" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Step list -->
            <ListBox x:Name="StepList" Grid.Column="0" BorderThickness="0" Background="{StaticResource PanelBrush}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="8"
                     SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="8">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#FBFBFC" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentBrush}" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Number}" Foreground="White" FontWeight="SemiBold" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="1" Width="96" Height="56" Margin="8,0" CornerRadius="4" BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1" Background="{StaticResource PanelBrush}" ClipToBounds="True">
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding KindLabel}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource LineBrush}" />

            <!-- Empty state -->
            <StackPanel x:Name="EmptyState" Grid.Column="0" Grid.ColumnSpan="3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="No steps yet" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,16" TextWrapping="Wrap" MaxWidth="420"
                           Text="Click Record, do the task the way you'd show a colleague, then click Stop. Every click and every bit of typing becomes a step with a screenshot." />
                <Button Style="{StaticResource AccentButton}" Click="OnRecord" HorizontalAlignment="Center" Padding="18,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="10" Height="10" Fill="White" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="Start recording" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Step details -->
            <Grid x:Name="DetailPane" Grid.Column="2" Margin="16,12,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                    <TextBlock x:Name="StepHeader" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button DockPanel.Dock="Right" Content="Delete step" Style="{StaticResource ToolButton}" Margin="6,0,0,0"
                            Click="OnDeleteStep" ToolTip="Delete (Del)" />
                    <Button DockPanel.Dock="Right" Content="Add text step" Style="{StaticResource ToolButton}" Margin="6,0,0,0"
                            Click="OnAddNote" ToolTip="Insert a step without a screenshot after this one" />
                    <Button DockPanel.Dock="Right" Content="Move down" Style="{StaticResource ToolButton}" Margin="6,0,0,0"
                            Click="OnMoveDown" ToolTip="Ctrl+Down" />
                    <Button DockPanel.Dock="Right" Content="Move up" Style="{StaticResource ToolButton}" Margin="6,0,0,0"
                            Click="OnMoveUp" ToolTip="Ctrl+Up" />
                </DockPanel>

                <StackPanel Grid.Row="1">
                    <TextBlock Text="Caption" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="CaptionBox" FontSize="14" Padding="6,5" TextWrapping="Wrap"
                             Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnStepTextChanged" />
                    <TextBlock Text="Notes (optional)" Style="{StaticResource FieldLabel}" Margin="0,10,0,4" />
                    <TextBox x:Name="NotesBox" Padding="6,5" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" MaxHeight="110"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnStepTextChanged" />
                </StackPanel>

                <DockPanel Grid.Row="2" Margin="0,14,0,8" LastChildFill="False" Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Drag on the screenshot to select an area, then:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="BlurButton" Content="Blur selection" Style="{StaticResource ToolButton}" Click="OnBlur" IsEnabled="False"
                            ToolTip="Pixelate the selected area to hide sensitive information" />
                    <Button x:Name="CropButton" Content="Crop to selection" Style="{StaticResource ToolButton}" Click="OnCrop" IsEnabled="False" />
                    <Button Content="Undo image edit" Style="{StaticResource ToolButton}" Click="OnUndoImage" IsEnabled="{Binding CanUndoImage}" />
                    <Button Content="Remove screenshot" Style="{StaticResource ToolButton}" Click="OnRemoveImage" />
                </DockPanel>

                <Border Grid.Row="3" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="6"
                        Visibility="{Binding HasImage, Converter={StaticResource BoolToVis}}">
                    <Grid x:Name="ImageHost" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <Image x:Name="StepImage" Source="{Binding Image}" Stretch="Uniform" StretchDirection="DownOnly"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Canvas x:Name="SelectionCanvas" Background="Transparent" Cursor="Cross"
                                MouseLeftButtonDown="OnSelectStart" MouseMove="OnSelectMove" MouseLeftButtonUp="OnSelectEnd">
                            <Rectangle x:Name="SelectionRect" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"
                                       StrokeDashArray="4 2" Fill="#33E8590C" Visibility="Collapsed" />
                        </Canvas>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
