<Window x:Class="StepCapture.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:StepCapture.App.Views"
        Title="StepCapture" Width="1320" Height="860" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource InkBrush}"
        Icon="/Assets/StepCapture.ico" AllowDrop="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header bar with gold underline -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" BorderBrush="{DynamicResource HeaderLineBrush}"
                BorderThickness="0,0,0,2" Padding="24,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/StepCapture.ico" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="STEPCAPTURE" Style="{StaticResource HeadingText}" FontSize="22" />
                        <TextBlock Text="Step-by-step guide recorder" FontStyle="Italic" FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}" Margin="0,-2,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" Margin="0,0,14,0" />
                    <Button x:Name="ThemeToggle" Style="{StaticResource PillButton}" Click="OnToggleTheme"
                            ToolTip="Switch between light and dark appearance">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ThemeIcon" FontFamily="Segoe UI Symbol" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock x:Name="ThemeLabel" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="24,18,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Hero card: guide title, description and main actions -->
            <Border Grid.Row="0" Style="{StaticResource Card}" CornerRadius="16" Padding="24,18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="24,0,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="New" Style="{StaticResource ToolButton}" Click="OnNew" ToolTip="Start an empty guide (Ctrl+N)" />
                            <Button Content="Open…" Style="{StaticResource ToolButton}" Click="OnOpen" ToolTip="Open a .stepguide file (Ctrl+O)" />
                            <Button Content="Save" Style="{StaticResource ToolButton}" Click="OnSave" ToolTip="Save (Ctrl+S)" />
                            <Button Content="Save as…" Style="{StaticResource ToolButton}" Click="OnSaveAs" />
                            <Button x:Name="ExportButton" Style="{StaticResource ToolButton}" Click="OnExportMenu" Margin="0"
                                    ToolTip="Export to HTML, Word, PDF or Markdown">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Export" />
                                    <TextBlock Text=" ▾" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="ExportMenu" />
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button x:Name="AddShotButton" Style="{StaticResource ToolButton}" Click="OnAddScreenshotMenu" Padding="14,8"
                                    ToolTip="Add a screenshot without recording: capture the screen, paste from the clipboard, or pick an image file">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Add screenshot" FontSize="14" />
                                    <TextBlock Text=" ▾" Foreground="{DynamicResource MutedBrush}" FontSize="14" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="AddShotMenu" />
                                </Button.ContextMenu>
                            </Button>
                            <Button x:Name="RecordButton" Style="{StaticResource AccentButton}" Click="OnRecord" Margin="0"
                                    Padding="20,8" ToolTip="Start capturing clicks and keystrokes">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="10" Height="10" Fill="#E5484D" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Record" FontSize="14" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBox x:Name="TitleBox" Style="{StaticResource BareTextBox}" FontFamily="{StaticResource HeadingFont}"
                                 FontStretch="Condensed" FontWeight="SemiBold" FontSize="30"
                                 TextChanged="OnGuideTextChanged" ToolTip="Guide title" />
                        <TextBox x:Name="DescriptionBox" Style="{StaticResource BareTextBox}" Foreground="{DynamicResource BodyBrush}"
                                 FontSize="14" Margin="0,4,0,0" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="60"
                                 VerticalScrollBarVisibility="Auto" TextChanged="OnGuideTextChanged"
                                 ToolTip="Optional description shown at the top of the guide" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Section label -->
            <DockPanel Grid.Row="1" Margin="0,20,0,10">
                <TextBlock Text="★" Foreground="{DynamicResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="SectionTitle" Text="STEPS" Style="{StaticResource SectionLabel}" FontSize="12" Margin="0,0,12,0" VerticalAlignment="Center" />
                <Rectangle Height="1" Fill="{DynamicResource LineBrush}" VerticalAlignment="Center" />
            </DockPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" MinWidth="260" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Step list -->
                <ListBox x:Name="StepList" Grid.Column="0" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnSelectionChanged" KeyDown="OnListKeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,4,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                                BorderThickness="1" CornerRadius="12" Padding="10">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource AccentBrush}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding BadgeText}" Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="Bold" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Grid.Column="1" Width="100" Height="58" Margin="10,0" CornerRadius="6"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        Background="{DynamicResource InputBrush}" ClipToBounds="True">
                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Caption}" TextWrapping="Wrap" MaxHeight="36" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource InkBrush}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <GridSplitter Grid.Column="1" Width="14" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- Empty state -->
                <Border x:Name="EmptyState" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource Card}" Padding="40">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="NO STEPS YET" Style="{StaticResource HeadingText}" FontSize="28" HorizontalAlignment="Center" />
                        <TextBlock Foreground="{DynamicResource BodyBrush}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,18"
                                   TextWrapping="Wrap" MaxWidth="440" FontSize="14"
                                   Text="Click Record, do the task the way you'd show a colleague, then click Stop. Every click and every bit of typing becomes a step with a screenshot. Use Add screenshot for overview shots of a screen without clicking." />
                        <Button Style="{StaticResource AccentButton}" Click="OnRecord" HorizontalAlignment="Center" Padding="20,9">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Fill="#E5484D" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="Start recording" FontSize="14" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Step details -->
                <Border x:Name="DetailPane" Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                            <TextBlock x:Name="StepHeader" Style="{StaticResource HeadingText}" FontSize="22" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Content="Delete step" Style="{StaticResource ToolButton}" Margin="6,0,0,0"
                                    Click="OnDeleteStep" ToolTip="Delete (Del)" />
                            <Button DockPanel.Dock="Right" Content="Add text step" Style="{StaticResource ToolButton}" Margin="6,0,0,0"
                                    Click="OnAddNote" ToolTip="Insert a step without a screenshot after this one" />
                            <Button DockPanel.Dock="Right" Content="Move down" Style="{StaticResource ToolButton}" Margin="6,0,0,0"
                                    Click="OnMoveDown" ToolTip="Ctrl+Down" />
                            <Button DockPanel.Dock="Right" Content="Move up" Style="{StaticResource ToolButton}" Margin="6,0,0,0"
                                    Click="OnMoveUp" ToolTip="Ctrl+Up" />
                        </DockPanel>

                        <StackPanel Grid.Row="1">
                            <TextBlock Text="CAPTION" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="CaptionBox" FontSize="14" TextWrapping="Wrap"
                                     Text="{Binding Caption, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnStepTextChanged" />
                            <CheckBox x:Name="OverviewBox" Margin="0,8,0,0" IsChecked="{Binding IsOverview, Mode=TwoWay}"
                                      Click="OnOverviewToggled" Foreground="{DynamicResource BodyBrush}"
                                      Content="Overview (shown as a heading, without a step number)"
                                      ToolTip="Use for screenshots that explain a screen or layout rather than an action" />
                            <TextBlock Text="NOTES (OPTIONAL)" Style="{StaticResource FieldLabel}" Margin="0,12,0,6" />
                            <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="46" MaxHeight="110"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" TextChanged="OnStepTextChanged" />
                        </StackPanel>

                        <local:ScreenshotEditor x:Name="Editor" Grid.Row="2" Grid.RowSpan="2" Margin="0,16,0,0"
                                                Item="{Binding}" Edited="OnScreenshotEdited"
                                                Visibility="{Binding ShowImageEditor, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
